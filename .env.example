# Copy this file to .env and fill in real values. Never commit .env.
#   cp .env.example .env && chmod 600 .env

# Public domain name that already points to this server's IP.
# No domain yet? Use <your-ip-with-dashes>.sslip.io, e.g. 203-0-113-10.sslip.io
DOMAIN=mahjong.example.com

# Redis password: a long random string. Generate one with any of these:
#   openssl rand -hex 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Hex only (0-9, a-f), so it is safe inside the redis:// URL without escaping.
REDIS_PASSWORD=

# How long a room is kept after its last activity (seconds). Default 24 hours.
ROOM_TTL_SECONDS=86400

# Close rooms idle for this many seconds (0 = never). Default 1 hour.
ROOM_IDLE_SECONDS=3600
